/**
 * Oldworld colorscheme for rofi
 * Based on oldworld.nvim by dgox16
 * https://github.com/dgox16/oldworld.nvim
 */

* {
    /* Color palette from oldworld.nvim */
    background:     #161617;
    foreground:     #c9c7cd;
    
    /* Normal colors */
    black:          #27272a;
    red:            #ea83a5;
    green:          #90b99f;
    yellow:         #e6b99d;
    blue:           #9ca2cf;
    magenta:        #e29eca;
    cyan:           #85b5ba;
    white:          #c9c7cd;
    
    /* Bright colors */
    bright-black:   #353539;
    bright-red:     #ed96b3;
    bright-green:   #a7c8b3;
    bright-yellow:  #eac5ae;
    bright-blue:    #acb1d7;
    bright-magenta: #e8b0d4;
    bright-cyan:    #97c0c4;
    bright-white:   #c9c7cd;
    
    /* Rofi specific colors */
    background-color: @background;
    text-color:       @foreground;
    
    /* Window colors */
    window-background: @background;
    window-border:     @cyan;
    
    /* Input bar colors */
    inputbar-background: @black;
    inputbar-foreground: @foreground;
    
    /* List colors */
    listview-background: @background;
    
    /* Element colors */
    element-normal-background:      transparent;
    element-normal-foreground:      @foreground;
    element-selected-background:    @bright-black;
    element-selected-foreground:    @cyan;
    element-alternate-background:   transparent;
    element-alternate-foreground:   @foreground;
    
    /* Scrollbar colors */
    scrollbar-handle: @cyan;
    
    /* Mode switcher colors */
    button-background: @black;
    button-foreground: @foreground;
    button-selected-background: @cyan;
    button-selected-foreground: @background;
}

window {
    background-color: @window-background;
    border:           2px;
    border-color:     @window-border;
    border-radius:    8px;
    padding:          8px;
    width:            600px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview, mode-switcher ];
    spacing:          8px;
}

inputbar {
    background-color: @inputbar-background;
    text-color:       @inputbar-foreground;
    border-radius:    4px;
    padding:          8px 12px;
    children:         [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

prompt {
    background-color: transparent;
    text-color:       @cyan;
    font:             "JetBrainsMono Nerd Font 10";
}

textbox-prompt-colon {
    background-color: transparent;
    text-color:       @cyan;
    expand:           false;
    str:              ":";
    margin:           0px 4px 0px 0px;
}

entry {
    background-color: transparent;
    text-color:       @inputbar-foreground;
    placeholder-color: @bright-black;
    placeholder:      "Search...";
}

case-indicator {
    background-color: transparent;
    text-color:       @yellow;
}

listview {
    background-color: @listview-background;
    border:           0px;
    padding:          4px 0px;
    scrollbar:        true;
    lines:            8;
    fixed-height:     false;
}

element {
    background-color: @element-normal-background;
    text-color:       @element-normal-foreground;
    border-radius:    4px;
    padding:          6px 8px;
}

element normal.normal {
    background-color: @element-normal-background;
    text-color:       @element-normal-foreground;
}

element normal.urgent {
    background-color: @red;
    text-color:       @background;
}

element normal.active {
    background-color: @green;
    text-color:       @background;
}

element selected.normal {
    background-color: @element-selected-background;
    text-color:       @element-selected-foreground;
}

element selected.urgent {
    background-color: @bright-red;
    text-color:       @background;
}

element selected.active {
    background-color: @bright-green;
    text-color:       @background;
}

element alternate.normal {
    background-color: @element-alternate-background;
    text-color:       @element-alternate-foreground;
}

element alternate.urgent {
    background-color: @red;
    text-color:       @background;
}

element alternate.active {
    background-color: @green;
    text-color:       @background;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold @yellow;
}

element-icon {
    background-color: transparent;
    size:             1.2em;
}

scrollbar {
    width:        4px;
    border:       0px;
    handle-color: @scrollbar-handle;
    handle-width: 4px;
    padding:      0px;
}

mode-switcher {
    background-color: transparent;
    spacing:          4px;
}

button {
    background-color: @button-background;
    text-color:       @button-foreground;
    border-radius:    4px;
    padding:          4px 8px;
}

button selected {
    background-color: @button-selected-background;
    text-color:       @button-selected-foreground;
}

message {
    background-color: @background;
    border:           1px;
    border-color:     @cyan;
    border-radius:    4px;
    padding:          8px;
}

textbox {
    background-color: transparent;
    text-color:       @foreground;
    highlight:        @yellow;
}
